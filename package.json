{
  "name": "llm-failsafe",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAI-compatible local LLM gateway with Codex CLI support, multi-upstream failover, and observability.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huayintianlai/LLM-Failsafe.git"
  },
  "bugs": {
    "url": "https://github.com/huayintianlai/LLM-Failsafe/issues"
  },
  "homepage": "https://github.com/huayintianlai/LLM-Failsafe#readme",
  "keywords": [
    "llm-gateway",
    "openai-compatible",
    "codex-cli",
    "responses-api",
    "failover",
    "observability",
    "nodejs",
    "docker"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node gateway.mjs",
    "start:phase1": "node simple-passthrough-proxy.mjs",
    "db:init": "node tools/init-db.mjs",
    "db:migrate": "node tools/migrate-db.mjs",
    "test": "node --test tests/unit/index.test.mjs tests/integration/index.test.mjs tests/failover/index.test.mjs tests/performance/index.test.mjs",
    "test:unit": "node --test tests/unit/index.test.mjs",
    "test:integration": "node --test tests/integration/index.test.mjs",
    "test:failover": "node --test tests/failover/index.test.mjs",
    "test:performance": "node --test tests/performance/index.test.mjs",
    "acceptance:phase1": "bash scripts/test-phase1.sh",
    "acceptance:codex": "bash scripts/acceptance-codex.sh"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "tiktoken": "^1.0.22",
    "yaml": "^2.8.1"
  }
}

# Copy this file to .env and replace every placeholder before running LLM-Hub.
# Never commit real API keys or production bearer tokens.

# Upstream API keys used by config/gateway.yaml.
UPSTREAM_PRIMARY_API_KEY=replace-with-primary-upstream-key
UPSTREAM_BACKUP_API_KEY=replace-with-backup-upstream-key
UPSTREAM_CLAUDE_API_KEY=replace-with-optional-claude-upstream-key

# Compatibility aliases for legacy helper scripts.
GPT_KEY_A=replace-with-backup-upstream-key
GPT_KEY_B=replace-with-primary-upstream-key
CLAUDE_KEY_A=replace-with-optional-claude-upstream-key

# Optional bearer token used by local tests and Codex CLI examples.
LLMHUB_TEST_BEARER_TOKEN=local-test-token

# Optional OpenClaw-compatible failover notifications.
OPENCLAW_GATEWAY_URL=http://localhost:3000
OPENCLAW_GATEWAY_TOKEN=replace-with-notification-token
NOTIFY_AGENT_ID=llmhub
NOTIFY_USER_ID=replace-with-user-id
